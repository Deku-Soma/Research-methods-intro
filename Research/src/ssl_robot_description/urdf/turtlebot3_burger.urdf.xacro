<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtlebot3_burger">

  <!-- =================================================================== -->
  <!-- TurtleBot3 Burger Comparative Baseline Model                       -->
  <!-- Track width: 160mm, Wheel diameter: 66mm, Total mass: ~1.0kg       -->
  <!-- =================================================================== -->

  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_separation" value="0.160"/>
  <xacro:property name="wheel_mass" value="0.028"/>

  <!-- Base Footprint at ground level -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <!-- Main lower chassis plate -->
    <visual>
      <origin xyz="-0.032 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.040"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <!-- Upper module tier -->
    <visual>
      <origin xyz="-0.032 0 0.050" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.060"/>
      </geometry>
      <material name="burger_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <!-- LDS-01 LiDAR on top tier -->
    <visual>
      <origin xyz="-0.032 0 0.095" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.030"/>
      </geometry>
      <material name="lidar_red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.032 0 0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.120"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.032 0 0.030" rpy="0 0 0"/>
      <mass value="0.825"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0" iyy="0.0024" iyz="0.0" izz="0.0031"/>
    </inertial>
  </link>

  <!-- =================================================================== -->
  <!-- Left and Right Wheels                                               -->
  <!-- =================================================================== -->
  <xacro:macro name="turtlebot_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tire_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia 
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" 
          ixy="0.0" ixz="0.0" 
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" 
          iyz="0.0" 
          izz="${(1.0/2.0) * wheel_mass * (wheel_radius*wheel_radius)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0.0 ${y_reflect * wheel_separation / 2.0} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:turtlebot_wheel prefix="left" y_reflect="1"/>
  <xacro:turtlebot_wheel prefix="right" y_reflect="-1"/>

  <!-- =================================================================== -->
  <!-- Passive Rear Caster Ball                                            -->
  <!-- =================================================================== -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="caster_metal">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.081 0.0 -0.028" rpy="0 0 0"/>
  </joint>

  <!-- =================================================================== -->
  <!-- Standardized Sensors: IMU & Tracking Sigil Link                     -->
  <!-- =================================================================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="tracking_sigil_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="tracking_sigil_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tracking_sigil_link"/>
    <origin xyz="-0.032 0 0.120" rpy="0 0 0"/>
  </joint>

  <!-- =================================================================== -->
  <!-- Gazebo Physics and Plugins                                          -->
  <!-- =================================================================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Differential Drive Plugin (standardized topics: /cmd_vel, /odom) -->
  <gazebo>
    <plugin name="turtlebot_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- IMU Sensor Plugin (standardized topic: /imu/data) -->
  <gazebo reference="imu_link">
    <sensor name="turtlebot_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="turtlebot_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Overhead Ground Truth Pose Plugin (standardized topic: /overhead_tracking/pose) -->
  <gazebo>
    <plugin name="turtlebot_overhead_tracking" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=overhead_tracking/pose</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>60.0</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.001</gaussian_noise>
    </plugin>
  </gazebo>

</robot>

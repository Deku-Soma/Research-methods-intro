<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Physical Properties from Research Proposal -->
  <xacro:property name="chassis_radius" value="0.050"/>  <!-- 100mm diameter -->
  <xacro:property name="chassis_height" value="0.090"/>  <!-- 90mm cylinder height + ground clearance -->
  <xacro:property name="chassis_mass" value="0.400"/>    <!-- 400g PLA Chassis + Pico + Battery -->

  <!-- Base footprint: Projection on the ground plane -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/> <!-- Axle center at z = 25mm (wheel radius) -->
  </joint>

  <!-- Base Link: Axle center is the origin (0, 0, 0) -->
  <link name="base_link">
    <visual>
      <!-- Cylindrical open-top chassis shell -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
      <material name="pla_cyan">
        <color rgba="0.12 0.53 0.89 0.95"/>
      </material>
    </visual>

    <!-- Top plate mounting sigil for overhead tracking camera -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2 + 0.026}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.002"/>
      </geometry>
      <material name="sigil_plate">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>

    <!-- Visual tracking pattern / orientation mark on top -->
    <visual>
      <origin xyz="0.020 0 ${chassis_height/2 + 0.027}" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.015 0.002"/>
      </geometry>
      <material name="sigil_direction_marker">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia 
        ixx="${(1.0/12.0) * chassis_mass * (3*chassis_radius*chassis_radius + chassis_height*chassis_height)}" 
        ixy="0.0" 
        ixz="0.0" 
        iyy="${(1.0/12.0) * chassis_mass * (3*chassis_radius*chassis_radius + chassis_height*chassis_height)}" 
        iyz="0.0" 
        izz="${(1.0/2.0) * chassis_mass * (chassis_radius*chassis_radius)}"/>
    </inertial>
  </link>

</robot>

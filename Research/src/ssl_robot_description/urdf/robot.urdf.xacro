<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ssl_differential_robot">

  <!-- Arguments -->
  <xacro:arg name="enable_camera" default="false"/>

  <!-- Include component files -->
  <xacro:include filename="$(find ssl_robot_description)/urdf/chassis.xacro"/>
  <xacro:include filename="$(find ssl_robot_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find ssl_robot_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find ssl_robot_description)/urdf/gazebo.xacro"/>

</robot>

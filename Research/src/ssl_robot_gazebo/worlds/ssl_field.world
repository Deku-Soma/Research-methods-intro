<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ssl_field_world">
    <!-- Directional Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics Parameters for Deterministic Simulation -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- RoboCup SSL Division B Field (Green Carpet Ground Plane) -->
    <model name="ssl_field_ground">
      <static>true</static>
      <link name="field_link">
        <collision name="field_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10.0 8.0</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="field_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10.0 8.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.08 0.45 0.15 1.0</ambient>
            <diffuse>0.10 0.50 0.20 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>

        <!-- White Boundary Lines (Visual) -->
        <visual name="boundary_line_north">
          <pose>0 3.0 0.001 0 0 0</pose>
          <geometry>
            <box><size>9.0 0.05 0.001</size></box>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="boundary_line_south">
          <pose>0 -3.0 0.001 0 0 0</pose>
          <geometry>
            <box><size>9.0 0.05 0.001</size></box>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="boundary_line_east">
          <pose>4.5 0 0.001 0 0 0</pose>
          <geometry>
            <box><size>0.05 6.0 0.001</size></box>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="boundary_line_west">
          <pose>-4.5 0 0.001 0 0 0</pose>
          <geometry>
            <box><size>0.05 6.0 0.001</size></box>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="center_halfway_line">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <box><size>0.05 6.0 0.001</size></box>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="center_spot">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.075</radius><length>0.001</length></cylinder>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Optional Simulated Overhead Camera Mount (Looking down at z=3.5m) -->
    <!-- Ready to be turned into a Gazebo camera sensor when vision tracking is activated -->
    <model name="overhead_rig_marker">
      <static>true</static>
      <pose>0 0 3.5 0 1.570796 0</pose>
      <link name="overhead_mount_link">
        <visual name="mount_visual">
          <geometry>
            <cylinder><radius>0.05</radius><length>0.1</length></cylinder>
          </geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
